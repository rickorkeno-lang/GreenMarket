# В деве не нужен — запросы к Catalog API идут через прокси в vite.config.ts
# (обходит отсутствующий CORS на бэке, см. бриф, раздел 10).
#
# Для прод-сборки (Vercel и т.п.) задать явно, когда согласуют домен/CORS с Романом:
# VITE_API_BASE=https://api.greenmarket.example/api/v1/catalog

# Маршрутизация OSRM: по умолчанию используется публичный https://router.project-osrm.org.
# Чтобы использовать локальный osrm-routed с поставленным MLD-индексом, задать здесь его HTTP endpoint:
# VITE_OSRM_SERVER_URL=http://localhost:5000
